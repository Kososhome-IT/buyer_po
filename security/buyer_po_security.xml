<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data noupdate="1">

        <!-- ===================================================== -->
        <!--  GROUP: Sales Country Manager                         -->
        <!-- ===================================================== -->
        <record id="group_sales_country_manager" model="res.groups">
            <field name="name">Sales Country Manager</field>
            <!-- Inherit normal Sales User rights -->
            <field name="implied_ids"
                   eval="[(4, ref('sales_team.group_sale_salesman'))]"/>
        </record>

        <!-- ===================================================== -->
        <!--  RECORD RULE: Sale Orders restricted by country       -->
        <!-- ===================================================== -->
        <record id="sale_order_country_manager_rule" model="ir.rule">
            <field name="name">Sale Orders – Country Manager Access</field>
            <field name="model_id" ref="sale.model_sale_order"/>

            <!-- Core restriction -->
            <field name="domain_force">
                [('country_origin', 'in', user.allowed_country_ids.ids)]
            </field>

            <!-- Apply ONLY to Sales Country Manager -->
            <field name="groups"
                   eval="[(4, ref('buyer_po.group_sales_country_manager'))]"/>

            <field name="perm_read" eval="1"/>
            <field name="perm_write" eval="1"/>
            <field name="perm_create" eval="1"/>
            <field name="perm_unlink" eval="0"/>
        </record>

    </data>
</odoo>
